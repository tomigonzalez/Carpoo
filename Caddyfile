# Caddy pide el certificado HTTPS solo, con Let's Encrypt.
# En desarrollo local (localhost) sirve por HTTP sin certificado.
{$SITE_ADDRESS:localhost} {
	encode gzip zstd

	# Cabeceras básicas de seguridad.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy carpoo:3000
}
