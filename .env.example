# --- Base de datos ---
# Local (Docker, ver docker-compose.dev.yml) — puerto 5433 para evitar conflicto con Postgres nativo en Windows:
DATABASE_URL="postgresql://carpoo:carpoo@localhost:5433/carpoo"
# Producción (Neon/Supabase): Vercel inyecta DATABASE_URL. Para operaciones de
# schema (db push) se usa conexión directa si existe:
#   Neon (Vercel la inyecta): DATABASE_URL_UNPOOLED
#   Supabase (puerto 5432):   DIRECT_URL="postgresql://postgres:...@db.<proyecto>.supabase.co:5432/postgres"

# --- URL pública de la app (para los callbacks de Google/Facebook) ---
APP_URL="http://localhost:3000"

# --- Clave para firmar la cookie de sesión ---
# Generala así: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# --- Inicio de sesión con Google (opcional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Inicio de sesión con Facebook (opcional) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Acceso de prueba (sin Google/Facebook). En producción: false ---
DEMO_LOGIN="true"

# --- Verificación del teléfono (Twilio: SMS o WhatsApp). Opcional ---
# Sin estas variables, el código se muestra en pantalla (solo para pruebas).
# Para WhatsApp real usá el número/sender de WhatsApp en TWILIO_FROM con el
# prefijo "whatsapp:" (ej. sandbox: whatsapp:+14155238886) o en TWILIO_WHATSAPP_FROM.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
