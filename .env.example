# --- Base de datos (SQLite: archivo local, sin servidor) ---
DATABASE_URL="file:./dev.db"

# --- URL pública de la app (para los callbacks de Google/Facebook) ---
APP_URL="http://localhost:3000"

# --- Clave para firmar la cookie de sesión ---
# Generala así: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# --- Inicio de sesión con Google (opcional) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Inicio de sesión con Facebook (opcional) ---
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Acceso de prueba (sin Google/Facebook). En producción: false ---
DEMO_LOGIN="true"
