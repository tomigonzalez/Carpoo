# Variables para "docker compose" (un solo servidor con la web y la base adentro).
# Copiá este archivo a .env.docker y usá --env-file .env.docker
# (así no pisás el .env que usás para desarrollo local).

# Dominio público. Caddy saca el certificado HTTPS solo.
#   - Con dominio propio:  carpoo.com.ar
#   - Sin comprar dominio: carpoo.203.0.113.10.nip.io   (usá la IP de tu servidor)
#   - En tu máquina:       localhost
SITE_ADDRESS="localhost"

# Tiene que coincidir con el dominio de arriba, con https://
APP_URL="http://localhost"

# Clave larga y aleatoria para firmar la sesión.
# Generala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# "true" deja el acceso de prueba por email (ideal para un demo).
# "false" en un producto real.
DEMO_LOGIN="true"

# Opcional: login con Google y Facebook.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
