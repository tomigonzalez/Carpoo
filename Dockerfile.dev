# Imagen de desarrollo: Next.js con hot reload.
# El código se monta como volumen; node_modules y .next quedan en volúmenes
# anónimos para no mezclar binarios de Windows con los de Linux.

FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

# Instalar dependencias primero (aprovecha caché de capas).
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

# El resto del código llega por el bind mount en docker-compose.
EXPOSE 3000
ENV NEXT_TELEMETRY_DISABLED=1

# Regenera el cliente Prisma (por si cambió el schema) y levanta el dev server.
CMD ["sh", "-c", "npx prisma generate && npx next dev --hostname 0.0.0.0"]
