# Imagen de desarrollo: Next.js con hot reload.
# El código se monta como volumen; node_modules y .next quedan en volúmenes
# anónimos para no mezclar binarios de Windows con los de Linux.

FROM node:22-alpine
WORKDIR /app

RUN apk add --no-cache libc6-compat openssl

# Instalar dependencias primero (aprovecha caché de capas).
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci

# Arranque: genera AUTH_SECRET, aplica el schema, siembra si hace falta y
# levanta el servidor. El código llega por el bind mount del compose.
COPY scripts/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000
ENV NEXT_TELEMETRY_DISABLED=1
ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npx", "next", "dev", "--hostname", "0.0.0.0"]
